# Optional convenience for the local spike harness only.
# The shipped app stores the OpenRouter key in the macOS Keychain, never in a file.
# Usage:  OPENROUTER_API_KEY=... swift run aimeter-spike
OPENROUTER_API_KEY=
CODEX_HOME_PERSONAL=~/.codex-aimeter-personal
CODEX_HOME_SECONDARY=~/.codex-aimeter-secondary
